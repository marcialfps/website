---
import { Image } from "astro:assets";
import BentoCard from "./BentoCard.astro";
import type { ProfileData } from "../../data/portfolio";

export interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<BentoCard
  as="section"
  class="lg:col-span-8 flex flex-col justify-between gap-6"
>
  <!-- Subtle technical dot-grid & volcanic amber glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] [background-size:20px_20px] [mask-image:radial-gradient(ellipse_70%_70%_at_80%_20%,black,transparent)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-yellow/[0.08] blur-3xl transition-opacity duration-500 group-hover:opacity-100 opacity-75"
  >
  </div>

  <!-- Top identity block -->
  <div class="relative flex flex-col gap-5">
    <div
      class="flex flex-col items-center text-center sm:flex-row sm:items-center sm:text-left gap-4 sm:gap-6"
    >
      <div
        class="relative h-24 w-24 sm:h-28 sm:w-28 shrink-0 overflow-hidden rounded-2xl border border-white/15 bg-obsidian shadow-[0_8px_24px_-8px_rgba(0,0,0,0.7)] ring-1 ring-white/10"
      >
        <Image
          src={profile.avatar}
          alt={profile.avatarAlt}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
          quality="mid"
        />
      </div>

      <div class="flex flex-col items-center sm:items-start gap-2">
        <span
          class="inline-flex w-fit items-center gap-2 rounded-full border border-yellow/25 bg-yellow/[0.08] px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-yellow"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-yellow" aria-hidden="true"
          ></span>
          {profile.role}
        </span>
        <h1
          class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white"
        >
          {profile.name}
        </h1>
        <p
          class="max-w-xl text-sm sm:text-base font-normal leading-relaxed text-zinc-300"
        >
          {profile.headline}
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom metrics & social bar -->
  <div class="relative flex flex-col gap-4 border-t border-white/10 pt-5">
    <!-- Responsive 3-column metrics -->
    <div class="grid grid-cols-3 gap-2 sm:gap-3">
      {
        profile.metrics.map((metric) => (
          <div class="flex flex-col justify-between rounded-xl border border-white/10 bg-black/25 px-3 py-2.5 sm:px-4 sm:py-3 transition-colors duration-200 hover:border-white/20">
            <span
              class="font-mono text-base sm:text-xl font-bold tracking-tight text-white"
              data-experience-since={metric.sinceDate}
            >
              {metric.value}
            </span>
            <span class="mt-0.5 font-mono text-[10px] sm:text-[11px] leading-tight text-zinc-400">
              {metric.label}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Social / contact links -->
    <div class="grid grid-cols-3 sm:flex sm:flex-wrap items-center gap-2">
      {
        profile.socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={
              link.href.startsWith("http") ? "noopener noreferrer" : undefined
            }
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 font-mono text-xs text-zinc-200 transition-colors duration-200 hover:border-yellow/40 hover:bg-yellow/[0.08] hover:text-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
          >
            <span>{link.label}</span>
            <span class="text-zinc-500" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BentoCard>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-experience-since]")
    .forEach((el) => {
      const since = el.dataset.experienceSince;
      if (!since) return;
      const start = new Date(since);
      if (Number.isNaN(start.getTime())) return;
      const now = new Date();
      let years = now.getFullYear() - start.getFullYear();
      const hasReachedAnniversary =
        now.getMonth() > start.getMonth() ||
        (now.getMonth() === start.getMonth() &&
          now.getDate() >= start.getDate());
      if (!hasReachedAnniversary) years -= 1;
      el.textContent = `${Math.max(0, years)}+ yrs`;
    });
</script>
