---
import BentoCard from "./BentoCard.astro";
import SectionHeader from "./SectionHeader.astro";
import type { ExperienceItem, EducationItem } from "../../data/portfolio";

export interface Props {
  experience: ExperienceItem[];
  education: EducationItem[];
}

const { experience, education } = Astro.props;
---

<section
  id="experience"
  class="lg:col-span-12 scroll-mt-20 flex flex-col gap-4"
  aria-labelledby="experience-heading"
>
  <SectionHeader
    id="experience-heading"
    title="Experience & Credentials"
    meta="2019 — Present"
  />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-5">
    <BentoCard as="div" class="lg:col-span-7 flex flex-col gap-5">
      <h3 class="font-mono text-xs font-medium text-zinc-300 border-b border-white/10 pb-2">
        Roles &amp; Leadership
      </h3>

  <div class="flex flex-col gap-5">
    {
      experience.map((job, idx) => (
        <div
          class={`flex flex-col gap-3 ${
            idx < experience.length - 1 ? "border-b border-white/10 pb-5" : ""
          }`}
        >
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <h3 class="text-base sm:text-lg font-semibold text-white">
                {job.role}
              </h3>
              <p class="text-sm text-yellow font-medium">
                {job.company}{" "}
                <span class="text-zinc-500 font-normal">· {job.location}</span>
              </p>
            </div>
            <span class="font-mono text-xs text-zinc-400 shrink-0">
              {job.period}
            </span>
          </div>

          <p class="text-sm text-zinc-300 leading-relaxed">{job.summary}</p>

          <ul class="space-y-1.5 text-xs sm:text-sm text-zinc-400">
            {job.highlights.map((item) => (
              <li class="flex items-start gap-2">
                <span
                  class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-yellow/70"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-1.5 pt-1">
            {job.stack.map((tech) => (
              <span class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5 font-mono text-[11px] text-zinc-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BentoCard>

    <BentoCard
      as="div"
      class="lg:col-span-5 flex flex-col justify-between gap-5"
    >
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-xs font-medium text-zinc-300 border-b border-white/10 pb-2">
          Certifications &amp; Education
        </h3>

    <ul class="flex flex-col divide-y divide-white/10">
      {
        education.map((edu) => (
          <li class="py-3 first:pt-0 last:pb-0 flex items-start justify-between gap-3">
            <div class="flex flex-col gap-0.5">
              <div class="flex items-center gap-2">
                <span
                  class={`rounded px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider border ${
                    edu.kind === "certification"
                      ? "border-yellow/30 bg-yellow/10 text-yellow"
                      : "border-white/15 bg-white/[0.04] text-zinc-300"
                  }`}
                >
                  {edu.kind === "certification" ? "Cert" : "Degree"}
                </span>
                <span class="font-mono text-[11px] text-zinc-500">
                  {edu.date}
                </span>
              </div>
              <p class="text-sm font-medium text-zinc-100 mt-1">{edu.title}</p>
              <p class="text-xs text-zinc-400">{edu.institution}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</BentoCard>
  </div>
</section>
