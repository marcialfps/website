---
import { Image } from "astro:assets";
import BentoCard from "./BentoCard.astro";
import SectionHeader from "./SectionHeader.astro";
import type { VolunteeringData } from "../../data/portfolio";

export interface Props {
  volunteering: VolunteeringData;
}

const { volunteering } = Astro.props;
---

<section
  id="community"
  class="lg:col-span-12 scroll-mt-20 flex flex-col gap-4"
  aria-labelledby="community-heading"
>
  <SectionHeader
    id="community-heading"
    title="Volunteering & Community Leadership"
    meta="Since 2014"
  />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <!-- Roles -->
    <BentoCard as="div" class="lg:col-span-7 flex flex-col justify-between gap-5">
      <p class="text-sm leading-relaxed text-zinc-400">
        {volunteering.summary}
      </p>

      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 border-t border-white/10 pt-4">
        {
          volunteering.roles.map((item) => (
            <li class="rounded-lg border border-white/10 bg-white/[0.02] p-3 flex flex-col justify-between gap-1">
              <span class="text-xs font-medium text-zinc-200 leading-snug">
                {item.role}
              </span>
              <div class="flex items-center justify-between gap-2 pt-1">
                <span class="text-[11px] text-zinc-400 truncate">
                  {item.organization}
                </span>
                <span class="font-mono text-[10px] text-zinc-500 shrink-0">
                  {item.period}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </BentoCard>

    <!-- Community Initiatives -->
    <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
      {
        volunteering.initiatives.map((initiative) => (
          <BentoCard as="article" class="flex flex-col sm:flex-row gap-4 p-4 sm:p-5">
            <div class="h-28 sm:h-auto sm:w-28 shrink-0 overflow-hidden rounded-xl border border-white/10 bg-obsidian">
              <Image
                src={initiative.image}
                alt={initiative.imageAlt}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
                quality="low"
              />
            </div>

            <div class="flex flex-col justify-between gap-2.5 grow">
              <div class="flex flex-col gap-1">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-sm sm:text-base font-semibold text-white group-hover:text-yellow transition-colors">
                    {initiative.title}
                  </h3>
                  <a
                    href={initiative.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-300 hover:text-yellow shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60 rounded"
                  >
                    <span>{initiative.linkLabel}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <p class="text-xs leading-relaxed text-zinc-400">
                  {initiative.description}
                </p>
              </div>

              <div class="flex flex-wrap gap-1">
                {initiative.tags.map((tag) => (
                  <span class="rounded border border-white/10 bg-white/[0.03] px-1.5 py-0.5 font-mono text-[10px] text-zinc-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </BentoCard>
        ))
      }
    </div>
  </div>
</section>
