---
import { Image } from "astro:assets";
import BentoCard from "./BentoCard.astro";
import SectionHeader from "./SectionHeader.astro";
import type { ProjectItem } from "../../data/portfolio";

export interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section
  id="projects"
  class="lg:col-span-12 scroll-mt-20 flex flex-col gap-4"
  aria-labelledby="projects-heading"
>
  <SectionHeader
    id="projects-heading"
    title="Selected Projects"
    meta={`${projects.length} items`}
  />

  <!-- Featured projects -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      featuredProjects.map((project) => (
        <BentoCard as="article" class="flex flex-col justify-between gap-5">
          <div class="flex flex-col gap-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex flex-col gap-1">
                <span class="font-mono text-[10px] uppercase tracking-wider text-yellow">
                  Featured Architecture
                </span>
                <h3 class="text-lg sm:text-xl font-semibold text-white group-hover:text-yellow transition-colors duration-200">
                  {project.title}
                </h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1.5 font-mono text-xs text-zinc-200 transition-colors duration-200 hover:border-yellow/40 hover:bg-yellow/10 hover:text-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
                  >
                    <span>{link.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>

            <p class="text-sm leading-relaxed text-zinc-400">
              {project.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 border-t border-white/10 pt-3.5">
            {project.architecture.map((tag) => (
              <span class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5 font-mono text-[11px] text-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        </BentoCard>
      ))
    }
  </div>

  <!-- Additional projects -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      otherProjects.map((project) => (
        <BentoCard as="article" class="flex flex-col justify-between gap-4 p-4 sm:p-5">
          <div class="flex flex-col gap-3">
            {project.image && (
              <div class="h-32 w-full overflow-hidden rounded-xl border border-white/10 bg-obsidian">
                <Image
                  src={project.image}
                  alt={project.imageAlt || project.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
                  quality="low"
                />
              </div>
            )}

            <div class="flex flex-col gap-1.5">
              <h3 class="text-base font-semibold text-white leading-snug group-hover:text-yellow transition-colors duration-200">
                {project.title}
              </h3>
              <p class="text-xs leading-relaxed text-zinc-400 line-clamp-3">
                {project.description}
              </p>
            </div>
          </div>

          <div class="flex flex-col gap-3 border-t border-white/10 pt-3">
            <div class="flex flex-wrap gap-1">
              {project.architecture.map((tag) => (
                <span class="rounded border border-white/10 bg-white/[0.03] px-1.5 py-0.5 font-mono text-[10px] text-zinc-300">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-end gap-2">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-mono text-xs text-zinc-300 transition-colors hover:text-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60 rounded"
                >
                  <span>{link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </BentoCard>
      ))
    }
  </div>
</section>
