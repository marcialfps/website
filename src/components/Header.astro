---
import LogoLetters from "./icons/LogoLetters.astro";

export interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;

const navItems = [
  { label: "Projects", href: "/#projects" },
  { label: "Experience", href: "/#experience" },
  { label: "Stack", href: "/#stack" },
  { label: "Community", href: "/#community" },
];
---

<header
  class="sticky top-0 z-30 w-full border-b border-white/10 bg-basalt/80 backdrop-blur-md"
>
  <div
    class={`mx-auto flex h-14 w-full min-w-0 items-center justify-between gap-3 px-4 sm:px-6 lg:px-8 ${
      wide ? "max-w-6xl" : "lg:max-w-screen-md lg:px-0"
    }`}
  >
    <a
      class="group flex min-w-0 shrink-0 items-center gap-2.5 rounded-md px-1 py-1 text-zinc-200 no-underline transition-colors duration-200 hover:text-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
      href="/"
      aria-label="Go to home page"
    >
      <LogoLetters class="h-3 w-auto sm:h-3.5 shrink-0" />
      <span
        class="hidden lg:inline-block font-mono text-[11px] text-zinc-500 transition-colors group-hover:text-zinc-300"
      >
        / full-stack &amp; cloud
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav
      class="hidden md:flex items-center gap-1.5"
      aria-label="Primary navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-2.5 py-1.5 font-mono text-xs text-zinc-400 no-underline transition-colors duration-200 hover:bg-white/[0.04] hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
          >
            {item.label}
          </a>
        ))
      }

      <a
        href="mailto:marcialfco@live.com"
        class="ml-1.5 inline-flex items-center gap-1 rounded-lg border border-yellow/30 bg-yellow/10 px-3 py-1.5 font-mono text-xs font-medium text-yellow no-underline transition-colors duration-200 hover:border-yellow/60 hover:bg-yellow/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
      >
        <span>Contact</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <!-- Mobile controls -->
    <div class="flex md:hidden items-center gap-2 shrink-0">
      <a
        href="mailto:marcialfco@live.com"
        class="inline-flex items-center gap-1 rounded-lg border border-yellow/30 bg-yellow/10 px-2.5 py-1.5 font-mono text-[11px] font-medium text-yellow no-underline transition-colors duration-200 hover:border-yellow/60 hover:bg-yellow/20"
      >
        <span>Contact</span>
        <span aria-hidden="true">↗</span>
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        aria-label="Toggle navigation menu"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-zinc-300 transition-colors hover:border-white/20 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow/60"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <nav
    id="mobile-nav-menu"
    aria-label="Mobile navigation"
    class="hidden md:hidden border-t border-white/10 bg-basalt/95 px-4 py-3 backdrop-blur-md"
  >
    <div class="grid grid-cols-2 gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2 font-mono text-xs text-zinc-300 no-underline transition-colors hover:border-yellow/30 hover:text-yellow"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-nav-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isOpen = !mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden", isOpen);
      toggleBtn.setAttribute("aria-expanded", String(!isOpen));
    });

    mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
