---
import Link from "../components/Link.astro";
import PageLayout from "../layouts/PageLayout.astro";

const data = await fetch(`${import.meta.env.S3_BUCKET}/acestream.json`).then((response) =>
  response.json()
);
---

<PageLayout title="TV">
  <div>
    {
      Object.keys(data).map((item) => (
        <section>
          <Link href={data[item]} newWindow>
            {item}
          </Link>
          <p>{data[item].split("//")[1]}</p>
        </section>
      ))
    }
  </div>
</PageLayout>
