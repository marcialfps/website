---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBento from "../components/bento/HeroBento.astro";
import AvailabilityWidget from "../components/bento/AvailabilityWidget.astro";
import ProjectsBento from "../components/bento/ProjectsBento.astro";
import ExperienceBento from "../components/bento/ExperienceBento.astro";
import StackBento from "../components/bento/StackBento.astro";
import CommunityBento from "../components/bento/CommunityBento.astro";
import { portfolioData } from "../data/portfolio";

const {
  profile,
  experience,
  education,
  skillGroups,
  projects,
  volunteering,
} = portfolioData;
---

<BaseLayout wide>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-5 pt-2">
    <HeroBento profile={profile} />
    <AvailabilityWidget availability={profile.availability} />
    <ProjectsBento projects={projects} />
    <ExperienceBento experience={experience} education={education} />
    <StackBento skillGroups={skillGroups} />
    <CommunityBento volunteering={volunteering} />
  </div>
</BaseLayout>
